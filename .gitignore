# ---- Python / 字节码 ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# ---- 测试与覆盖率 / Testing & coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- 运行产物 / Runtime artifacts ----
outputs/*
!outputs/.gitkeep
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.db-journal

# ---- 原始数据（体积大，走下载脚本）/ Raw data (fetched via scripts) ----
data/raw/
data/*.csv
data/*.xlsx
!data/sample/*.csv

# ---- 编辑器 / 操作系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 本地环境变量 / Local secrets ----
.env
.env.*
